{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "../..",
    "paths": {
      "@monky/shared": [
        "packages/shared/dist/index.d.ts"
      ],
      "@monky/server": [
        "apps/server/dist/index.d.ts"
      ],
      "@monky/server/dist/*": [
        "apps/server/dist/*"
      ],
      "electron": [
        "apps/client/node_modules/electron"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
