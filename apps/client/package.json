{
  "name": "@mini-voice/client",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "echo Client has no unit tests",
    "package": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "description": "Mini Voice — P2P Self-Hosted Voice, Video and Chat",
  "author": "Murilo",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiniVoiceOrg/Mini_Voice.git"
  },
  "dependencies": {
    "@mini-voice/server": "*",
    "@mini-voice/shared": "*",
    "electron-updater": "^6.8.9",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/uuid": "^10.0.0",
    "electron": "34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.minivoice.app",
    "productName": "Mini Voice",
    "electronVersion": "34.2.0",
    "asar": false,
    "directories": {
      "output": "../../release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MiniVoiceOrg",
        "repo": "Mini_Voice"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Mini-Voice-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Mini-Voice-${version}-win-${arch}-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "artifactName": "Mini-Voice-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
