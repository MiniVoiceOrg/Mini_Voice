{
  "name": "@monky/client",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "echo Client has no unit tests",
    "package": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "description": "Monky — P2P Self-Hosted Voice, Video and Chat",
  "author": "Murilo",
  "repository": {
    "type": "git",
    "url": "https://github.com/MonkyOrg/Monky.git"
  },
  "dependencies": {
    "@monky/screen-audio": "file:./native/screen-audio",
    "@monky/server": "*",
    "@monky/shared": "*",
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "electron-updater": "^6.8.9",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "electron": "34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.monky.app",
    "productName": "Monky",
    "electronVersion": "34.2.0",
    "asar": false,
    "directories": {
      "output": "../../release",
      "buildResources": "build"
    },
    "detectUpdateChannel": false,
    "publish": [
      {
        "provider": "github",
        "owner": "MonkyOrg",
        "repo": "Monky"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Monky-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Monky-${version}-win-${arch}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "artifactName": "Monky-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
